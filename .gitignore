# Rust
/target/
# Cargo.lock is committed. This crate produces a final artifact, the GDExtension
# shared library, so a pinned lockfile makes CI and releases reproducible.

# Godot
/.godot/*
# Without this, running from the CLI without opening the editor loads no extension.
!/.godot/extension_list.cfg
*.import

# Build output, placed by scripts/build.ps1 and build.sh.
/addons/godot_servo/bin/

# Local working files
*.log
# git-cliff writes this during a release; the notes live on the release itself.
/CHANGELOG.md
# Local settings written by Godot version managers
.godotrc
/httpd.log

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
