[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.4"
; Servo can only be initialised once per process, so hot reload is out.
reloadable = false

[libraries]

; scripts/build.ps1 and build.sh put cargo's output here.
; debug and release are not separated: there is no reason to match Godot's build
; type to Rust's profile. Either Godot loads the same binary.
windows.x86_64 = "res://addons/godot_servo/bin/windows/godot_servo.x86_64.dll"
linux.x86_64 = "res://addons/godot_servo/bin/linux/libgodot_servo.x86_64.so"
macos = "res://addons/godot_servo/bin/macos/libgodot_servo.dylib"
; arm64-v8a only on Android. x86_64 survives on emulators and ChromeOS, neither of
; which has been run on hardware here, so it is left out.
android.debug.arm64 = "res://addons/godot_servo/bin/android/arm64-v8a/libgodot_servo.so"
android.release.arm64 = "res://addons/godot_servo/bin/android/arm64-v8a/libgodot_servo.so"

[dependencies]

; ANGLE. Surfman grabs it at runtime with `LoadLibrary("libEGL.dll")`, by name, so
; it has to sit in the same folder as the extension's DLL (src/angle_loader.rs
; preloads it by absolute path). scripts/build.* distributes what mozangle built.
windows.x86_64 = {
"res://addons/godot_servo/bin/windows/libEGL.dll" : "",
"res://addons/godot_servo/bin/windows/libGLESv2.dll" : ""
}
