+/// The downlevel flags an adapter has to expose to be considered compliant.
+///
+/// This is [`wgt::DownlevelFlags::compliant()`] everywhere but Android, which
+/// drops `SURFACE_VIEW_FORMATS` from it. wgpu-hal derives that flag from
+/// `VK_KHR_swapchain_mutable_format`, an extension Android's Vulkan drivers do
+/// not expose, so requiring it rejects every adapter on the platform. The flag
+/// only governs which view formats a texture from
+/// `Surface::get_current_texture` may be viewed as, so an embedder that renders
+/// offscreen is held to a capability it never reaches.
+fn required_downlevel_flags() -> wgt::DownlevelFlags {
+    let mut flags = wgt::DownlevelFlags::compliant();
+    if cfg!(target_os = "android") {
+        flags.remove(wgt::DownlevelFlags::SURFACE_VIEW_FORMATS);
+    }
+    flags
+}
