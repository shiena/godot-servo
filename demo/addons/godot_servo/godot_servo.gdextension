[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
; Servo はプロセスに 1 つしか立てられないのでホットリロードは不可。
reloadable = false

[libraries]

windows.debug.x86_64 = "res://addons/godot_servo/bin/godot_servo.dll"
windows.release.x86_64 = "res://addons/godot_servo/bin/godot_servo.dll"
macos.debug = "res://addons/godot_servo/bin/libgodot_servo.dylib"
macos.release = "res://addons/godot_servo/bin/libgodot_servo.dylib"
linux.debug.x86_64 = "res://addons/godot_servo/bin/libgodot_servo.so"
linux.release.x86_64 = "res://addons/godot_servo/bin/libgodot_servo.so"

[dependencies]

; surfman が実行時に名前で掴む。拡張と同じフォルダに置いておく必要がある。
windows.debug.x86_64 = {
"res://addons/godot_servo/bin/libEGL.dll": "",
"res://addons/godot_servo/bin/libGLESv2.dll": ""
}
windows.release.x86_64 = {
"res://addons/godot_servo/bin/libEGL.dll": "",
"res://addons/godot_servo/bin/libGLESv2.dll": ""
}
